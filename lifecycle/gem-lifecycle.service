# GitHubOpsGem B200 lifecycle controller (WU-07) — awsbox.
# Install with:  sudo ./lifecycle/deploy_awsbox.sh      (idempotent; see --help)
#   journalctl -u gem-lifecycle -f        # one JSON line per decision (scale, cap_tripped, check_failed, ...)
#
# If this service stops, nothing scales the B200 down except Fireworks' own scale-to-zero window, so keep that
# window at 5m (the controller warns at startup when it is longer). Remove it with deploy_awsbox.sh --uninstall,
# which puts the B200 to sleep first.
#
# EnvironmentFile= is not a shell: "KEY=13.0  # note" makes the value "13.0  # note". Keep comments on their own
# line; deploy_awsbox.sh refuses (or rewrites) values with whitespace or "#".

[Unit]
Description=GitHubOpsGem B200 lifecycle controller (wake/sleep + GPU spend caps)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gem
Group=gem
EnvironmentFile=/etc/gem/lifecycle.env
ExecStart=/usr/bin/python3 -I /opt/gem/gem_lifecycle.py serve
Restart=always
RestartSec=5
StateDirectory=gem
StateDirectoryMode=0750

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
