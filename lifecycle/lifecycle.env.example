# /etc/gem/lifecycle.env — B200 lifecycle controller (WU-07). Mode 0640 root:gem. Never commit real values.
#
# systemd reads this file with EnvironmentFile=: a "#" only starts a comment at the beginning of a line. Anything
# after the "=" (including a trailing "# note") becomes the value, so keep every comment on its own line and
# values free of spaces and "#". deploy_awsbox.sh refuses a file that breaks this rule.

# Fireworks key with permission to read and scale the deployment (stays on awsbox).
FIREWORKS_API_KEY=
# The dedicated deployment (same value LiteLLM's ds-burst uses, with or without the "openai/" prefix).
GEM_BURST_DEPLOYMENT=accounts/YOUR_ACCOUNT/deployments/YOUR_DEPLOYMENT

# Controller API bearers, one per role (deploy_awsbox.sh generates them and keeps existing ones).
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Operator: every endpoint (gemctl heavy on/off). On Termux it lives in ~/.gem/operator.token, never in env.
GEM_LIFECYCLE_TOKEN=
# Feed: LiteLLM's callback; may only call /touch and /signal/429. Put it in LiteLLM's environment.
GEM_LIFECYCLE_FEED_TOKEN=
# Session: Claude Code hooks; may only call /session/start, /session/end and GET /status.
GEM_LIFECYCLE_SESSION_TOKEN=
GEM_LIFECYCLE_BIND=127.0.0.1:8090

# Spend caps (decided 2026-11-07). 4 x B200 at $13/GPU-hour = $52/h, so $26/day is 30 GPU-replica minutes.
# ASSUMPTION: the GPU rate; confirm on fireworks.ai/pricing.
GEM_GPU_RATE_USD_PER_HOUR=13.0
GEM_GPU_CAP_DAY_USD=26
GEM_GPU_CAP_WEEK_USD=78
# Days and Monday-start weeks roll over in this zone (needs tzdata; the controller refuses an unknown zone).
GEM_CAP_TZ=America/Chicago

# Sleep policy.
# Seconds after the last ds-burst request finishes.
GEM_IDLE_SLEEP_S=180
# Seconds after the last Claude Code session ends.
GEM_SESSION_END_SLEEP_S=45
# This many ds-main 429s ...
GEM_429_WAKE_COUNT=3
# ... within this many seconds wake the B200.
GEM_429_WINDOW_S=120
# A request whose "end" never arrives stops holding the B200 awake after this many seconds.
GEM_REQUEST_LEASE_S=660
GEM_POLL_S=15

# Unused auto-delete is a create-time setting the Fireworks API does not report, and `firectl deployment
# update` cannot change it. Pick one (deploy_awsbox.sh asks):
#   GEM_AUTODELETE_VERIFIED=1     the deployment was created with --unused-auto-delete-duration 0
#   GEM_AUTODELETE_ACCEPT_RISK=1  it may auto-delete after 7 idle days; wakes allowed, status shows the risk
# With neither, the controller refuses every wake (sleep and caps still work).
GEM_AUTODELETE_VERIFIED=0
GEM_AUTODELETE_ACCEPT_RISK=0

# Spend ledger (survives restarts and upgrades). If it is ever unreadable, wakes stay refused until the next
# weekly rollover.
GEM_LIFECYCLE_STATE=/var/lib/gem/lifecycle.json

# First week: GEM_LIFECYCLE_DRY=1 logs every scale decision without calling Fireworks.
GEM_LIFECYCLE_DRY=0
