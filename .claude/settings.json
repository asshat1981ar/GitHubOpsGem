{
  "permissions": {
    "allow": [
      "Bash(python3 -m pytest:*)",
      "Bash(python3 -I probes.py:*)",
      "Bash(python3 -I lifecycle/gem_lifecycle.py dryrun)",
      "Bash(python3 -I gemctl.py scan-diff:*)",
      "Bash(python3 -I gemctl.py debt:*)",
      "Bash(python3 -I gemctl.py version)",
      "Bash(actionlint:*)",
      "Bash(zizmor --offline:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
