# Claude Code client env for the DeepSeek gateway (Termux side). `source` before `claude`.
# Tunnel first:  ssh -N -L 8000:127.0.0.1:8000 -L 8080:127.0.0.1:8080 -L 8090:127.0.0.1:8090 awsbox  (or Tailscale)
#   8000 LiteLLM gateway · 8080 autodev-server (ForgeCore) · 8090 B200 lifecycle controller

export ANTHROPIC_BASE_URL="http://127.0.0.1:8000"
export ANTHROPIC_AUTH_TOKEN="${LITELLM_VIRTUAL_KEY:?set a LiteLLM virtual key, not the master key}"

# Serverless-first (2026-11-07 decision): every tier on per-token DeepSeek V4.1 Flash.
# `gem heavy on` wakes the 4xB200 deployment and waits until it serves; then `/model ds-burst` in Claude Code
# (or `eval "$(gem heavy on --export)"` before launching claude). It sleeps 180 s after the last request.
export ANTHROPIC_MODEL="ds-main"
export ANTHROPIC_DEFAULT_OPUS_MODEL="ds-main"
export ANTHROPIC_DEFAULT_SONNET_MODEL="ds-main"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="ds-fast"
export CLAUDE_CODE_SUBAGENT_MODEL="ds-main"

# Keep the 96k / 16k budget real on the client (serverless allows ~1M, but every turn resends context).
export CLAUDE_CODE_AUTO_COMPACT_WINDOW="96000"
export CLAUDE_CODE_MAX_OUTPUT_TOKENS="16384"
export API_TIMEOUT_MS="600000"          # long generations; VERIFY name in your Claude Code version

# GitHubOpsGem enforcement: WARN for week one, then ENFORCE automatically.
export GEM_ENFORCEMENT="WARN"
export GEM_ENFORCE_AFTER="2026-11-14"   # ASSUMPTION: go-live 2026-11-07; change to go-live + 7 days

# ADR-007: ForgeCore (autodev-server on awsbox) signs every gate verdict. The signing key stays on the
# server (AUTODEV_GATE_SIGNING_KEY); this client only holds the API bearer.
export AUTODEV_URL="http://127.0.0.1:8080"
export AUTODEV_API_BEARER_TOKEN="${AUTODEV_API_BEARER_TOKEN:?set the autodev-server API bearer}"
export GEM_REPOSITORY="${GEM_REPOSITORY:-$(git config --get remote.origin.url 2>/dev/null | sed -E 's#.*github.com[:/]##; s#\.git$##')}"

# WU-07: B200 lifecycle controller (awsbox, through the tunnel). None of its tokens is the Fireworks key.
# claude and its hooks get only the SESSION token: register/unregister sessions and read status, never wake the B200.
# The operator token (wake/sleep) lives in ~/.gem/operator.token (chmod 600); `gem` reads it per call and never
# exports it. This is defense in depth, not isolation: anything running as you can still read that file.
export GEM_LIFECYCLE_URL="${GEM_LIFECYCLE_URL:-http://127.0.0.1:8090}"
export GEM_LIFECYCLE_SESSION_TOKEN="${GEM_LIFECYCLE_SESSION_TOKEN:?set the lifecycle SESSION token (GEM_LIFECYCLE_SESSION_TOKEN in /etc/gem/lifecycle.env on awsbox)}"
unset GEM_LIFECYCLE_TOKEN GEM_LIFECYCLE_FEED_TOKEN     # keep the operator and LiteLLM bearers out of claude's env
gem() { GEM_LIFECYCLE_TOKEN="$(cat "${GEM_HOME:-$HOME/.gem}/operator.token" 2>/dev/null)" python3 "${GEM_HOME:-$HOME/.gem}/lib/gemctl.py" "$@"; }   # gem heavy on|off|status, gem gate, ...
